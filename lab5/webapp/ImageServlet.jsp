<%@ page contentType="image/png" trimDirectiveWhitespaces="true" %>
<%@ page import="java.awt.*, java.awt.geom.*, java.awt.image.*, javax.imageio.*" %>
<%@ page import="java.io.*" %>
<%
    // The handout's example, with the size and the text taken from the request
    int width = parse(request.getParameter("w"), 400);
    int height = parse(request.getParameter("h"), 240);
    String text = request.getParameter("text") == null ? "Hello!" : request.getParameter("text");

    BufferedImage bufferedImage = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
    Graphics2D g2d = bufferedImage.createGraphics();
    g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
    g2d.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON);

    // fill the image with colour
    g2d.setColor(Color.BLUE);
    g2d.fillRect(0, 0, width, height);

    // a sine wave across the picture
    g2d.setColor(new Color(120, 170, 255));
    g2d.setStroke(new BasicStroke(3f));
    Path2D.Double wave = new Path2D.Double();
    for (int x = 0; x <= width; x++) {
        double y = height * 0.72 - height * 0.12 * Math.sin(4 * Math.PI * x / width);
        if (x == 0) wave.moveTo(x, y); else wave.lineTo(x, y);
    }
    g2d.draw(wave);

    // a yellow sun in the corner
    g2d.setColor(Color.YELLOW);
    int r = Math.min(width, height) / 8;
    g2d.fillOval(width - 3 * r, r, 2 * r, 2 * r);

    // draw the text
    g2d.setColor(Color.WHITE);
    g2d.setFont(new Font("SansSerif", Font.BOLD, Math.max(12, height / 8)));
    g2d.drawString(text, width / 10, height / 2);
    g2d.setFont(new Font("SansSerif", Font.PLAIN, Math.max(10, height / 20)));
    g2d.drawString("generated by ImageServlet.jsp at " + new java.text.SimpleDateFormat("HH:mm:ss").format(new java.util.Date()), width / 10, height - height / 14);
    g2d.dispose();

    // set the header and write the image; "out" is the implicit JspWriter, so the stream gets another name
    response.setContentType("image/png");
    response.setHeader("Cache-Control", "no-store");
    OutputStream os = response.getOutputStream();
    ImageIO.write(bufferedImage, "png", os);
    os.close();
%>
<%! int parse(String value, int fallback) {
        try {
            return Math.max(50, Math.min(1200, Integer.parseInt(value)));
        } catch (Exception e) {
            return fallback;
        }
    } %>
